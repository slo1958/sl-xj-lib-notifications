#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Opening()
		  System.DebugLog("WIndow handle " + HandleToInt.ToHex)
		  
		  lb_handle.Text = "Window handle " + HandleToInt.ToString
		  
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Function HandleToInt() As int64
		  var v as variant = self.Handle
		  
		  return v.Int64Value
		  
		  
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SignalReceived(Sender as string, Topic as String, Message as String, SenderID as integer)
		  // Part of the Module1.itfNotifiable interface.
		  
		  Listbox1.AddRow("")
		  Listbox1.ColumnCount = 4
		  
		  listbox1.CellTextAt(Listbox1.LastAddedRowIndex, 0) = Sender
		  listbox1.CellTextAt(Listbox1.LastAddedRowIndex, 1) = Topic
		  listbox1.CellTextAt(Listbox1.LastAddedRowIndex, 2) = Message
		  listbox1.CellTextAt(Listbox1.LastAddedRowIndex, 3) = SenderID.ToString
		  
		  
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events Button1
	#tag Event
		Sub Pressed()
		  var topic as string = tf_SubTopic.Text.Trim
		  
		  call clNotificationManager.GetDefault.Subscribe(topic, self, HandleToInt)
		  
		  tf_SubTopic.Text =""
		  
		  
		  var arr() as pair = clNotificationManager.GetDefault.ListMySubscriptionsWithID(HandleToInt)
		  
		  listbox2.RemoveAllRows
		  listbox2.ColumnCount = 2
		  
		  listbox2.HeaderAt(0) = "ID"
		  listbox2.HeaderAt(1) = "Topic"
		  
		  for each s as pair in arr
		    listbox2.AddRow(s.Left.StringValue)
		    listbox2.CellTextAt(listbox2.LastAddedRowIndex, 1) = s.Right
		    
		  next
		  
		  return
		  
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button2
	#tag Event
		Sub Pressed()
		  clNotificationManager.GetDefault.Publish(CurrentMethodName,  tf_sendTopic.text.trim ,  tf_sendMsg.text.trim, HandleToInt)
		  
		  
		End Sub
	#tag EndEvent
#tag EndEvents
