#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Opening()
		  //
		  // This is used to test and demonstrate the use of the 'details' field
		  //
		  
		  //
		  // The window will subscribe to the 'update_listbox' topic
		  // Since we do not want to apply filtering on ClientID, we use -1
		  //
		  
		  call clNotificationManager.SubscribeToDefault("update-listbox",self, -1)
		  
		  //
		  // The window implements the interface itfNotifiableWithRawMessage, so it will receive the complete message
		  //
		  
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Sub MessageReceived(msg as clNotificationMessage)
		  // Part of the Notifications.itfNotifiableWithRawMessage interface.
		  
		   
		  var listbox as DesktopListBox
		  
		  
		  if msg.MessageDetails isa DesktopListBox then
		    listbox = DesktopListBox(msg.MessageDetails)
		    
		    listbox.AddRow("Received [" + msg.Message+ "] from [ " + msg.Sender + "]")
		    
		  end if
		  
		  
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events btn_add_left
	#tag Event
		Sub Pressed()
		  
		  clNotificationManager.PublishToDefault(CurrentMethodName, "update-listbox", tf_message.text.trim(), lb_left, -1)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btn_add_right
	#tag Event
		Sub Pressed()
		  
		  clNotificationManager.PublishToDefault(CurrentMethodName, "update-listbox", tf_message.text.trim(), lb_right, -1)
		End Sub
	#tag EndEvent
#tag EndEvents
