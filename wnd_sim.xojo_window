End
#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Closing()
		  
		  clNotificationManager.GetDefault.CancelSubscriptions(Subscriptions)
		End Sub
	#tag EndEvent

	#tag Event
		Sub Opening()
		  //
		  // Put all subscriptions in an array, so we can esaily unsubscribe when the window is closing
		  //
		  
		  self.Subscriptions.Add(clNotificationManager.SubscribeToDefault(cClockSimTopic, self, -1))
		   
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Sub NotificationReceived(Sender as string, Topic as String, Message as String, SenderClientID as int64)
		  // Part of the Notifications.itfNotifiable interface.
		  
		  var t as string = DateTime.Now.SQLDateTime
		  Listbox1.AddRowAt(0, t + ". " + Message)
		   
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h0
		Subscriptions() As Integer
	#tag EndProperty


	#tag Constant, Name = cClockSimTopic, Type = String, Dynamic = False, Default = \"clk", Scope = Public
	#tag EndConstant


#tag EndWindowCode

#tag Events btn_sim
	#tag Event
		Sub Pressed()
		  var p() as pair
		  
		  for i as integer = 0 to 9
		    p.Add(cClockSimTopic: "Simulated message " + i.ToString)
		    
		  next
		  
		  Listbox1.RemoveAllRows
		   
		  NotificationSimulator(p, 2000, cClockSimTopic, "$Done$")
		   
		  
		  return
		End Sub
	#tag EndEvent
#tag EndEvents
